# 服务
PORT=3520
DATA_DIR=./data
ADMIN_TOKEN=change-me-before-public-use

# demo：内置规则，无需模型；openai-compatible：使用兼容接口选择动作
DECIDER_MODE=demo
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# 主动治理（默认保守）
ALLOWED_ACTIONS=silent,defer,note,webhook
MIN_ACTION_GAP_SECONDS=1200
DAILY_ACTION_LIMIT=12
DEFAULT_DEFER_SECONDS=900
SWEEP_INTERVAL_SECONDS=900
ACTIVE_SILENCE_SECONDS=1200

# webhook 动作默认没有目标；配置后也需在 ALLOWED_ACTIONS 中显式允许
WEBHOOK_URL=
